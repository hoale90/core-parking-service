{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=parking_service.db"
  },
  "ParkingRules": {
    "PlateMatchThresholdPercent": 80.0
  },
  "OcrService": {
    "BaseUrl": "http://localhost:8000",
    "HealthEndpoint": "/health",
    "OcrEndpoint": "/ocr",
    "TimeoutSeconds": 10
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
